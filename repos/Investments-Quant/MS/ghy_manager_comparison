def process_all_managers(base):
    tracker = read_tracker(base)
    all_headline, all_currency, all_region, all_country, all_timeseries = [], {}, {}, {}, {}
    processed_manager_excels = {}

    folder_candidates = []
    for d in os.listdir(base):
        dp = os.path.join(base, d)
        if os.path.isdir(dp):
            excels = find_excel_in_folder(dp)
            if excels:
                folder_candidates.append((d, dp, excels))

    for _, row in tracker.iterrows():
        fund_name = row['Fund Name']
        benchmark = row.get('Benchmark', '')
        isin = row.get('ISIN', '')
        assets = row.get('Assets (EUR M)', '')
        has_fx = row.get('has_fx', True)

        for folder_name, folder_path, excels in folder_candidates:
            if not folder_matches_fund(folder_name, fund_name):
                continue

            manager_key = folder_name.lower()
            strategy_limit = get_manager_strategy_limit(folder_name)
            seen_excels = processed_manager_excels.setdefault(manager_key, set())
            if strategy_limit is not None and len(seen_excels) >= strategy_limit:
                continue

            if len(excels) == 1:
                target = excels[0]
            else:
                target = pick_best_excel(fund_name, excels)
                if strategy_limit is not None and not target:
                    remaining = [e for e in sorted(excels) if e not in seen_excels]
                    target = remaining[0] if remaining else sorted(excels)[0]

            if strategy_limit is not None and target in seen_excels:
                target = None
                remaining = [e for e in sorted(excels) if e not in seen_excels]
                if remaining:
                    target = remaining[0]

            # Generic behavior: when multiple files exist for a manager, avoid
            # reusing the same workbook until all candidates have been used once.
            if target and target in seen_excels and len(seen_excels) < len(excels):
                remaining = [e for e in sorted(excels) if e not in seen_excels]
                if remaining:
                    rem_best = pick_best_excel(fund_name, remaining)
                    target = rem_best or remaining[0]

            if target:
                processed_ok = process_single_file(
                    os.path.join(folder_path, target), fund_name, benchmark, isin, assets,
                    folder_name, has_fx, all_headline, all_currency, all_region, all_country, all_timeseries
                )
                if processed_ok:
                    seen_excels.add(target)
                if strategy_limit is not None and not processed_ok:
                    remaining = [e for e in sorted(excels) if e not in seen_excels and e != target]
                    for chosen in remaining:
                        processed_ok = process_single_file(
                            os.path.join(folder_path, chosen), fund_name, benchmark, isin, assets,
                            folder_name, has_fx, all_headline, all_currency, all_region, all_country, all_timeseries
                        )
                        if processed_ok:
                            seen_excels.add(chosen)
                            break
            else:
                if strategy_limit is not None:
                    remaining = [e for e in sorted(excels) if e not in seen_excels]
                    for chosen in remaining:
                        processed_ok = process_single_file(
                            os.path.join(folder_path, chosen), fund_name, benchmark, isin, assets,
                            folder_name, has_fx, all_headline, all_currency, all_region, all_country, all_timeseries
                        )
                        if processed_ok:
                            seen_excels.add(chosen)
                            break
                else:
                    for name in excels:
                        process_single_file(
                            os.path.join(folder_path, name), fund_name, benchmark, isin, assets,
                            folder_name, has_fx, all_headline, all_currency, all_region, all_country, all_timeseries
                        )
            break

    headline_df = pd.DataFrame(all_headline)

    if MANUAL_ENTRIES:
        manual_df = pd.DataFrame(MANUAL_ENTRIES).dropna(axis=1, how='all')
        manual_df = manual_df.drop(columns=['Currency', 'Region', 'Country'], errors='ignore')
        headline_df = pd.concat([headline_df, manual_df], ignore_index=True)
        for entry in MANUAL_ENTRIES:
            label = f"{entry['Manager']} - {entry['Fund Name']}"
            if entry.get('Currency'):
                all_currency[label] = entry['Currency']
            if entry.get('Region'):
                all_region[label] = entry['Region']
            if entry.get('Country'):
                all_country[label] = entry['Country']

    def collect_keys(d):
        keys = set()
        for v in d.values():
            keys |= set(v.keys())
        return sorted(keys)

    return (
        headline_df,
        build_breakdown_df(all_currency, collect_keys(all_currency)),
        build_breakdown_df(all_region, collect_keys(all_region)),
        build_breakdown_df(all_country, collect_keys(all_country)),
        all_timeseries,
    )


def build_breakdown_df(data_dict, all_keys):
    if not all_keys:
        return pd.DataFrame()

    rows = [{'Strategy': label, **{k: vals.get(k) for k in all_keys}} for label, vals in data_dict.items()]
    df = pd.DataFrame(rows)

    numeric_cols = [c for c in df.columns if c != 'Strategy']
    for col in numeric_cols:
        df[col] = pd.to_numeric(df[col], errors='coerce')

    agg = {'Strategy': 'Average (Peer Group)'}
    count = {'Strategy': 'Count (non-zero)'}
    for col in numeric_cols:
        valid = df[col].dropna()
        agg[col] = valid.mean() if len(valid) > 0 else None
        count[col] = int((valid > 0).sum())
    df = pd.concat([df, pd.DataFrame([agg, count])], ignore_index=True)
    return df


def normalise_series_to_percent(series_dict):
    """Normalise one time-series to percentage scale using a single series-level rule."""
    parsed = []
    for date_str, raw_val in (series_dict or {}).items():
        try:
            v = float(raw_val)
        except (TypeError, ValueError):
            continue
        parsed.append((str(date_str), v))

    if not parsed:
        return {}

    # Decide scale once per series to avoid mixed-unit flips (e.g. 3.59 then 0.99).
    max_abs = max(abs(v) for _, v in parsed)
    uses_decimal_scale = max_abs <= 1.5

    out = {}
    for d, v in parsed:
        pct = v * 100 if uses_decimal_scale else v
        pct = max(0.0, min(100.0, pct))
        out[d] = round(pct, 4)
    return out


def normalise_timeseries_percent(timeseries):
    """Normalise all manager time-series to percentage scale for plotting/aggregation."""
    normalised = {}
    for manager, mgr_data in (timeseries or {}).items():
        if not isinstance(mgr_data, dict):
            continue
        mgr_out = {}
        for key, vals in mgr_data.items():
            if not isinstance(key, str) or not isinstance(vals, dict):
                continue
            norm_vals = normalise_series_to_percent(vals)
            if norm_vals:
                mgr_out[key] = norm_vals
        if mgr_out:
            normalised[manager] = mgr_out
    return normalised


def save_to_excel(headline_df, currency_df, region_df, country_df, output_dir):
    output_path = output_dir / OUTPUT_EXCEL
    with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
        headline_df.to_excel(writer, sheet_name='Headline Stats', index=False)
        if not currency_df.empty:
            currency_df.to_excel(writer, sheet_name='Currency Breakdown', index=False)
        if not region_df.empty:
            region_df.to_excel(writer, sheet_name='Region Breakdown', index=False)
        if not country_df.empty:
            country_df.to_excel(writer, sheet_name='Country Breakdown', index=False)
    print(f"\nExcel saved: {output_path}")


