def normalise_label(label):
    s = str(label).strip()
    return LABEL_MAP.get(s, LABEL_MAP.get(s.lower(), s))


def normalise_scale(data):
    """If values look like 0-100 percentages, convert to 0-1 decimals."""
    vals = [v for v in data.values() if v is not None]
    try:
        nums = [float(v) for v in vals]
    except (ValueError, TypeError):
        return data
    if nums and max(nums) > 1.5:
        return {k: (float(v) / 100 if v is not None else None) for k, v in data.items()}
    return data


