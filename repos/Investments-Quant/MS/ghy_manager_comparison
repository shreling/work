def _tooltip_wrap(short_text, full_text, css_class=''):
    tip = html.escape(full_text).replace('\n', '&#10;')
    cls = f'has-tip {css_class}'.strip()
    return f'<span class="{cls}">{short_text}<span class="tip-box">{html.escape(full_text)}</span></span>'


def fmt_benchmark(raw_bmk):
    if raw_bmk is None or (isinstance(raw_bmk, float) and pd.isna(raw_bmk)):
        return '<span class="bmk-tag bmk-none">No benchmark</span>'
    s = str(raw_bmk).strip()
    low = s.lower()
    if not s or s == 'nan':
        return '<span class="bmk-tag bmk-none">No benchmark</span>'
    no_bmk_keywords = ['no benchmark', 'no formal benchmark', 'do not follow any benchmark', 'cash benchmark']
    if any(k in low for k in no_bmk_keywords):
        return _tooltip_wrap('<span class="bmk-tag bmk-none">No benchmark</span>', s)
    custom_keywords = ['custom', '50%', '30%', '35%', '70%', 'blended']
    if any(k in low for k in custom_keywords):
        return _tooltip_wrap('<span class="bmk-tag bmk-custom">Custom benchmark</span>', s)
    return html.escape(s)


def _extract_short(val, col):
    import re
    s = str(val).strip()
    if len(s) <= 50:
        return None
    low = s.lower()
    if col == 'YTM (%)':
        m = re.search(r'(\d+\.\d+%)', s)
        return m.group(1) if m else s[:40]
    if col == 'OAS (bps)':
        m = re.search(r'(\d+[\.,]?\d*)\s*(?:bps|bp)', s, re.I)
        if m:
            return m.group(1) + ' bps'
        if 'not' in low or 'don' in low or 'n/a' in low:
            return 'N/A'
        return s[:40]
    if col == 'Eff. Duration (yrs)':
        matches = re.findall(r'(\d+\.\d+)\s*(?:yr|year)', s, re.I)
        if matches:
            return ' / '.join(matches) + ' yrs'
        return s[:40]
    if col == 'Avg Rating':
        if 'breakdown' in low or 'cash:' in low or 'aaa:' in low or 'bbb:' in low:
            return 'See details'
        m = re.search(r'\b(A{1,3}|B{1,3}|C{1,3})([+-])?\b', s)
        if m:
            return m.group(0)
        if 'not rated' in low or 'n/a' in low:
            return 'NR'
        return s[:40]
    if col == 'Num Issues':
        cleaned = re.sub(r'\b\d{4}\b', '', s)
        m = re.search(r'(\d{2,})', cleaned)
        return m.group(1) if m else s[:30]
    if col == 'Domicile':
        m = re.match(r'([A-Z][a-z]+(?:\s[A-Z][a-z]+)?)', s)
        return m.group(1) if m else s.split('.')[0][:30]
    if col == 'UCITS Status':
        if 'ucits' in low:
            return 'UCITS'
        if 'non-ucits' in low or 'not ucits' in low:
            return 'Non-UCITS'
        return s[:30]
    return s[:40]


def smart_cell(val, col, is_num=False):
    if val is None or (isinstance(val, float) and pd.isna(val)):
        return '—'
    import re
    s = str(val).strip()
    s = re.sub(r'(\d),(\d{1,2})(?!\d)', r'\1.\2', s)
    if col == 'YTM (%)':
        try:
            v = float(s)
            if 0 < v < 1:
                return f'{v * 100:.1f}%'
        except (ValueError, TypeError):
            pass
    if col == 'Eff. Duration (yrs)':
        try:
            v = float(s)
            return f'{v:.1f}'
        except (ValueError, TypeError):
            pass
    if col == 'OAS (bps)':
        try:
            v = float(s)
            return f'{v:.1f}'
        except (ValueError, TypeError):
            pass
    short = _extract_short(val, col)
    if short is None:
        return html.escape(s)
    short = re.sub(r'(\d),(\d{1,2})(?!\d)', r'\1.\2', short)
    return _tooltip_wrap(html.escape(short), s)


