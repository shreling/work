def read_tracker(base):
    tracker_path = base / TRACKER_FILENAME
    df = pd.read_excel(tracker_path, header=0)
    df = df.dropna(subset=['Fund Name'])
    valid_statuses = ['spreadsheet sent', 'spreadsheet does not contain fx']
    sent = df[df['Excel Sent ?'].str.strip().str.lower().isin(valid_statuses)].copy()
    sent['has_fx'] = sent['Excel Sent ?'].str.strip().str.lower() == 'spreadsheet sent'
    return sent


def find_excel_in_folder(folder_path):
    excels = []
    for root, _, files in os.walk(folder_path):
        for f in files:
            if not f.endswith('.xlsx'):
                continue
            if f.startswith('~$'):
                continue
            full_path = os.path.join(root, f)
            rel_path = os.path.relpath(full_path, folder_path)
            excels.append(rel_path)
    return sorted(excels)


def extract_headline_stats_standard(ws):
    stats = {}
    as_of_date = None
    for row in ws.iter_rows(max_row=20, values_only=True):
        cells = list(row)
        for i, cell in enumerate(cells):
            if cell and isinstance(cell, str):
                stripped = cell.strip()
                if stripped in HEADLINE_FIELDS and i + 1 < len(cells):
                    stats[stripped] = cells[i + 1]
                if stripped.lower() == 'isin' and i + 1 < len(cells):
                    stats['ISIN'] = cells[i + 1]
                if stripped == 'Strategy Info' and i + 1 < len(cells) and cells[i + 1]:
                    stats['Strategy Description'] = cells[i + 1]
                if 'data as of' in stripped.lower() or 'as of' in stripped.lower():
                    as_of_date = stripped
    if as_of_date:
        stats['As Of Date'] = as_of_date
    return stats


def extract_headline_stats_crossingbridge(ws):
    stats = {}
    for row in ws.iter_rows(max_row=15, values_only=True):
        cells = list(row)
        if cells and cells[0] and isinstance(cells[0], str):
            stripped = cells[0].strip()
            if stripped in HEADLINE_FIELDS and len(cells) > 1:
                stats[stripped] = cells[1]
    return stats


def _headline_payload_score(stats):
    score = 0
    for f in HEADLINE_FIELDS:
        v = stats.get(f)
        if v is not None and str(v).strip() != '':
            score += 1
    isin_v = stats.get('ISIN')
    if isin_v is not None and str(isin_v).strip() != '':
        score += 1
    return score


def extract_headline_stats_flexible(wb):
    """Extract headline stats from the best candidate sheet in a workbook."""
    ordered_candidates = []

    # Prefer the dedicated strategy sheet where available (e.g., Goldman template).
    for s in wb.sheetnames:
        if s.strip().lower() == 'strategy info':
            ordered_candidates.append(s)
    for s in wb.sheetnames:
        if s not in ordered_candidates:
            ordered_candidates.append(s)

    best_stats = {}
    best_score = -1
    for s in ordered_candidates:
        stats = extract_headline_stats_standard(wb[s])
        score = _headline_payload_score(stats)
        if score > best_score:
            best_stats = stats
            best_score = score

        # Good enough payload found; avoid unnecessary sheet scans.
        if score >= 3:
            break

    return best_stats


def extract_breakdown_section(ws, section_label, max_search_row=80):
    rows = list(ws.iter_rows(values_only=True))
    start_idx = None
    start_col = None
    for i, row in enumerate(rows[:max_search_row]):
        if not row:
            continue
        for j, cell in enumerate(row[:8]):
            if cell and isinstance(cell, str) and cell.strip().lower().startswith(section_label.lower()):
                start_idx = i
                start_col = j
                break
        if start_idx is not None:
            break

    if start_idx is None:
        return {}

    header_row = rows[start_idx]
    value_cols = [j for j in range((start_col or 0) + 1, len(header_row)) if header_row[j] is not None]

    if not value_cols:
        return {}

    last_col_idx = value_cols[-1]
    result = {}
    for row in rows[start_idx + 1:start_idx + 60]:
        if row is None or (start_col is not None and (start_col >= len(row) or row[start_col] is None)):
            break
        label = normalise_label(row[start_col])
        if label.lower() in ('total', '') or label.startswith('*'):
            break
        val = row[last_col_idx] if last_col_idx < len(row) else None
        if val is None and last_col_idx > (start_col or 0) + 1:
            for j in range(min(last_col_idx, len(row) - 1), (start_col or 0), -1):
                if row[j] is not None:
                    val = row[j]
                    break
        result[label] = val

    return normalise_scale(result)


def extract_breakdown_from_sheet(wb, sheet_name):
    if sheet_name not in wb.sheetnames:
        return {}, {}, {}
    ws = wb[sheet_name]
    currency = extract_breakdown_section(ws, 'Currency')
    region = extract_breakdown_section(ws, 'Region')
    country = extract_breakdown_section(ws, 'Country')
    return currency, region, country


def extract_breakdowns_flexible(wb):
    """Extract Currency/Region/Country even when they are split across sheets."""
    sheet_lowers = {s: s.lower() for s in wb.sheetnames}

    currency_sheet = next((s for s, low in sheet_lowers.items() if 'currency' in low), None)
    region_sheet = next((s for s, low in sheet_lowers.items() if 'region' in low and 'country' not in low), None)
    country_sheet = next((s for s, low in sheet_lowers.items() if 'country' in low and 'region' not in low), None)
    fx_sheet = next((s for s, low in sheet_lowers.items() if 'fx' in low), None)

    currency = extract_breakdown_section(wb[currency_sheet], 'Currency') if currency_sheet else {}
    region = extract_breakdown_section(wb[region_sheet], 'Region') if region_sheet else {}
    country = extract_breakdown_section(wb[country_sheet], 'Country') if country_sheet else {}

    # Fallback to a combined FX sheet if a dedicated section was not found.
    if fx_sheet:
        if not currency:
            currency = extract_breakdown_section(wb[fx_sheet], 'Currency')
        if not region:
            region = extract_breakdown_section(wb[fx_sheet], 'Region')
        if not country:
            country = extract_breakdown_section(wb[fx_sheet], 'Country')

    # Final fallback: scan all sheets for any missing sections, regardless of sheet name.
    fallback_hits = []
    if not currency or not region or not country:
        for s in wb.sheetnames:
            ws = wb[s]
            if not currency:
                c = extract_breakdown_section(ws, 'Currency')
                if c:
                    currency = c
                    fallback_hits.append(s)
            if not region:
                r = extract_breakdown_section(ws, 'Region')
                if r:
                    region = r
                    fallback_hits.append(s)
            if not country:
                cty = extract_breakdown_section(ws, 'Country')
                if cty:
                    country = cty
                    fallback_hits.append(s)
            if currency and region and country:
                break

    # Preserve order while avoiding duplicate sheet scans.
    date_sheet_candidates = []
    for s in (currency_sheet, region_sheet, country_sheet, fx_sheet):
        if s and s not in date_sheet_candidates:
            date_sheet_candidates.append(s)
    for s in fallback_hits:
        if s and s not in date_sheet_candidates:
            date_sheet_candidates.append(s)

    as_of = None
    for s in date_sheet_candidates:
        as_of = _get_last_date_from_sheet(wb[s])
        if as_of:
            break

    return currency, region, country, as_of, date_sheet_candidates


def _has_numeric_data(row):
    return any(isinstance(c, (int, float)) for c in row[1:] if c is not None)


def _extract_latest_row_as_dict(ws, header_row_idx=0):
    rows = list(ws.iter_rows(values_only=True))
    if not rows:
        return {}
    header = rows[header_row_idx]
    labels = [normalise_label(c) for c in header[1:] if c is not None]
    last_row = None
    for r in rows[header_row_idx + 1:]:
        if r[0] is not None and _has_numeric_data(r):
            last_row = r
    if last_row and labels:
        d = {labels[i]: last_row[i + 1] for i in range(len(labels)) if i + 1 < len(last_row)}
        return normalise_scale(d)
    return {}


def extract_crossingbridge_breakdowns(wb):
    currency, region, country = {}, {}, {}
    for sname in wb.sheetnames:
        lower = sname.lower()
        if 'currency' in lower:
            currency = _extract_latest_row_as_dict(wb[sname])
        elif 'region' in lower and 'country' not in lower:
            region = _extract_latest_row_as_dict(wb[sname])
        elif 'country' in lower and 'region' not in lower:
            country = _extract_latest_row_as_dict(wb[sname])
    return currency, region, country


def _get_last_date_from_sheet(ws):
    """Extract the last date column header from an FX/breakdown sheet."""
    from datetime import datetime as dt
    for row in ws.iter_rows(max_row=5, values_only=True):
        dates = [c for c in row[1:] if c is not None and isinstance(c, (dt, datetime))]
        if dates:
            last = max(dates)
            return last.strftime('%d/%m/%Y')
        str_dates = [c for c in row[1:] if c is not None and isinstance(c, str) and any(ch.isdigit() for ch in c)]
        if str_dates:
            return str(str_dates[-1])
    return None


def _get_last_date_crossingbridge(wb):
    """CrossingBridge has dates in col A, so grab the last non-None row."""
    from datetime import datetime as dt
    for sname in wb.sheetnames:
        if 'currency' in sname.lower():
            ws = wb[sname]
            last_date = None
            for row in ws.iter_rows(values_only=True):
                if row[0] is not None and isinstance(row[0], (dt, datetime)):
                    last_date = row[0]
            if last_date:
                return last_date.strftime('%d/%m/%Y')
    return None


