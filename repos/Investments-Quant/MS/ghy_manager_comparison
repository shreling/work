def get_manager_strategy_limit(folder_name):
    low = str(folder_name).lower()
    for key, limit in MANAGER_STRATEGY_LIMITS.items():
        if key in low:
            return limit
    return None


def expand_fund_words(fund_name):
    words = set()
    for w in fund_name.lower().split():
        words.add(w)
        if w in WORD_ALIASES:
            for aw in WORD_ALIASES[w].split():
                words.add(aw)
    return {w for w in words if len(w) > 2}


def folder_matches_fund(folder_name, fund_name):
    if not fund_name:
        return False
    fn_lower = fund_name.lower()
    fl_lower = folder_name.lower()

    # Normalize punctuation so names like "Lombard-Odier" or "Tell's" still match.
    fn_alnum = ''.join(ch if ch.isalnum() or ch.isspace() else ' ' for ch in fn_lower)
    fl_alnum = ''.join(ch if ch.isalnum() or ch.isspace() else ' ' for ch in fl_lower)

    if fl_lower in fn_lower:
        return True
    if fl_alnum in fn_alnum:
        return True
    for alias in FOLDER_TO_FUND_ALIAS.get(folder_name, []):
        alias_lower = alias.lower()
        alias_alnum = ''.join(ch if ch.isalnum() or ch.isspace() else ' ' for ch in alias_lower)
        if alias_lower in fn_lower or alias_alnum in fn_alnum:
            return True
    fn_tokens = {t for t in fn_alnum.split() if len(t) > 2}
    fl_tokens = {t for t in fl_alnum.split() if len(t) > 2}
    if fn_tokens & fl_tokens:
        return True
    return False


def pick_best_excel(fund_name, excels):
    fn_words = expand_fund_words(fund_name) if fund_name else set()
    noise = {'franklin', 'templeton', 'global', 'high', 'yield', 'ghy', 'manager', 'data'}
    scored = []
    for name in excels:
        en_words = set(w for w in name.lower().replace('.xlsx', '').replace('-', ' ').replace('_', ' ').split() if len(w) > 2)
        score = len(fn_words & en_words) * 2 - len(en_words - fn_words - noise)
        scored.append((score, name))
    scored.sort(key=lambda x: -x[0])
    return scored[0][1] if scored[0][0] > 0 else None


def extract_timeseries_from_sheet(wb, sheet_name):
    if sheet_name not in wb.sheetnames:
        return {}
    ws = wb[sheet_name]
    rows = list(ws.iter_rows(values_only=True))
    result = {}

    def _detect_section_start(section_label):
        for i, row in enumerate(rows[:80]):
            if not row:
                continue
            for j, cell in enumerate(row[:8]):
                if cell and isinstance(cell, str) and cell.strip().lower().startswith(section_label.lower()):
                    return i, j
        return None, None

    def _parse_date_col(cell):
        if cell is None:
            return None
        if isinstance(cell, datetime):
            return cell
        if isinstance(cell, str) and any(ch.isdigit() for ch in cell):
            try:
                return pd.to_datetime(cell)
            except Exception:
                return None
        return None

    for section_label in ('Currency', 'Region', 'Country'):
        start_idx, start_col = _detect_section_start(section_label)
        if start_idx is None:
            continue

        header = rows[start_idx]
        date_cols = []
        for j in range((start_col or 0) + 1, len(header)):
            d = _parse_date_col(header[j])
            if d is not None:
                date_cols.append((j, d))
        if not date_cols:
            continue

        for row in rows[start_idx + 1:start_idx + 60]:
            if row is None or (start_col is not None and (start_col >= len(row) or row[start_col] is None)):
                break
            label = normalise_label(row[start_col])
            if label.lower() in ('total', '') or label.startswith('*'):
                break

            series = {}
            for col_idx, d in date_cols:
                val = row[col_idx] if col_idx < len(row) else None
                if val is not None:
                    try:
                        series[d.strftime('%Y-%m-%d')] = float(val)
                    except (ValueError, TypeError):
                        pass
            if series:
                key = f"{section_label}|{label}"
                result[key] = series
    return result


def process_single_file(excel_path, fund_name, benchmark, isin, assets,
                        folder_name, has_fx, all_headline, all_currency, all_region, all_country, all_timeseries):
    try:
        wb = openpyxl.load_workbook(excel_path, read_only=True, data_only=True)
    except Exception as e:
        print(f"  ERROR reading {excel_path}: {e}")
        return False

    is_cb = 'crossingbridge' in folder_name.lower()

    if is_cb:
        stats = extract_headline_stats_crossingbridge(wb[wb.sheetnames[0]])
    else:
        stats = extract_headline_stats_flexible(wb)

    def _norm_isin(v):
        if v is None:
            return ''
        return str(v).upper().replace(' ', '').replace('-', '')

    # Barings exception: only process output when sheet ISIN matches tracker ISIN.
    if 'barings' in folder_name.lower():
        tracker_isin_norm = _norm_isin(isin)
        sheet_isin_norm = _norm_isin(stats.get('ISIN'))
        if not sheet_isin_norm or sheet_isin_norm != tracker_isin_norm:
            wb.close()
            print(
                f"  Skipped (ISIN mismatch): {folder_name} / {os.path.basename(excel_path)} "
                f"[tracker={isin}, sheet={stats.get('ISIN', '')}]"
            )
            return False

    output_isin = isin
    if 'barings' in folder_name.lower() and stats.get('ISIN') not in (None, ''):
        output_isin = stats.get('ISIN')

    all_headline.append({
        'Manager': folder_name,
        'Fund Name': fund_name,
        'ISIN': output_isin,
        'Assets (EUR M)': assets,
        'Benchmark (Tracker)': benchmark,
        'Benchmark (Fund)': stats.get('Fund reference benchmark', ''),
        'As Of Date': stats.get('As Of Date', stats.get('Strategy Description', '')),
        'YTM (%)': stats.get('Yield To Maturity (%)', ''),
        'OAS (bps)': stats.get('Option Adjusted Spread (bps)', ''),
        'Eff. Duration (yrs)': stats.get('Effective Duration (yrs)', ''),
        'Avg Rating': stats.get('Average Rating', ''),
        'Num Issues': stats.get('Number of issues', ''),
        'Domicile': stats.get('Fund Domicile/Legal structure', ''),
        'UCITS Status': stats.get('Fund Legal Status (UCITS)', ''),
    })

    label = f"{folder_name} - {fund_name}"
    if not has_fx:
        cur, reg, cty = {}, {}, {}
        as_of = None
    elif is_cb:
        cur, reg, cty = extract_crossingbridge_breakdowns(wb)
        as_of = _get_last_date_crossingbridge(wb)
    else:
        cur, reg, cty, as_of, ts_sheets = extract_breakdowns_flexible(wb)
        merged_ts = {}
        for s in ts_sheets:
            ts = extract_timeseries_from_sheet(wb, s)
            if ts:
                merged_ts.update(ts)
        if merged_ts:
            all_timeseries[label] = merged_ts

    if as_of:
        all_headline[-1]['As Of Date'] = as_of

    # Business override: force BNY Mellon currency exposure to 100% USD.
    if 'bny mellon' in folder_name.lower():
        cur = {'USD': 1.0}

    if cur:
