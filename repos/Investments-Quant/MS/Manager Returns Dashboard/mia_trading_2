# Query to fetch eps revision data 

eps_revision_query = f""" SELECT
FSYM_ID,
CONS_START_DATE,
CURRENCY,
FE_UP,
FE_DOWN,
FE_NUM_EST
FROM FACTSET.FE_V4.FE_BASIC_CONH_AF
WHERE CONS_START_DATE > '2025-06-01'
AND FE_NUM_EST > '5'
ORDER BY CONS_START_DATE ASC"""

eps_revision = cur.execute(eps_revision_query)
eps_revision_df = pd.DataFrame(eps_revision.fetchall(), columns=[col[0] for col in cur.description])

# Calculate the revision by FE_UP -FE_DOWN/ FE_NUM_EST and store it in a new column called REVISIONs

eps_revision_df['REVISION'] = (eps_revision_df['FE_UP'] - eps_revision_df['FE_DOWN']) / eps_revision_df['FE_NUM_EST']

