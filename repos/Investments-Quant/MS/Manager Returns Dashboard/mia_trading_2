# Query to fetch FYSM_ID data from Snowflake 

fsym_id_query = f"""SELECT
    sih.ISIN,
    sih.FSYM_ID,
    sih.START_DATE AS START_DATE_ISIN,
    sc.CURRENCY,
    sc.PROPER_NAME,
    sc.FREF_LISTING_EXCHANGE,
    sc.FSYM_REGIONAL_ID,
    sc.FSYM_SECURITY_ID
FROM FACTSET.SYM_V1.SYM_ISIN_HIST sih
LEFT JOIN FACTSET.SYM_V1.SYM_COVERAGE sc
    ON sih.FSYM_ID = sc.FSYM_SECURITY_ID
WHERE
    sc.FREF_SECURITY_TYPE = 'SHARE'
    AND sc.FSYM_ID IN (
        SELECT DISTINCT FSYM_PRIMARY_LISTING_ID
        FROM FACTSET.SYM_V1.SYM_COVERAGE
        WHERE REGIONAL_FLAG = 'TRUE'
    )
    AND sc.FSYM_REGIONAL_ID IN (
        SELECT DISTINCT FSYM_PRIMARY_LISTING_ID
        FROM FACTSET.SYM_V1.SYM_COVERAGE
        WHERE SECURITY_FLAG = 'TRUE'
    )
AND
    sc.ACTIVE_FLAG = 'TRUE'
AND
    sih.MOST_RECENT = 'TRUE'
ORDER BY
    sc.PROPER_NAME"""

fsym_id = cur.execute(fsym_id_query)

